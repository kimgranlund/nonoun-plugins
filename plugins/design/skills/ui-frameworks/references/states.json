{
  "$description": "The state matrix of ui-frameworks as data. Each state has one id and one condition: the selector a recipe uses for it in every target, and the value of the same-named condition in the Panda preset. `author` is the author attribute on a custom-element root, `componentWrites` the managed attribute the component keeps in step, `native` what a native element offers. A state with `base` and `excludes` holds when its base selector matches and none of the excluded states does; its `condition` is composed from those and `node scripts/docs.mjs --check` refuses one that differs. `fixtures` are elements the condition must match and must not match; `node checks/states/run.mjs` tests them in three browser engines. A fixture is an HTML string, or an object with `html`, an optional `script` run with the target as `el`, and a `note`. The target is the element marked `data-t`, or else the first element. `pandaBase` is the selector Panda's own preset-base gives the same name, read from the v2 branch on 2026-11-12, and `pandaSame` says whether it equals the condition once quotes and the leading `&` are ignored. The tables in docs/specs/state-matrix.md are generated from this file.",
  "version": 1,
  "testElements": {
    "x-undefined": "a custom element name that is never defined: the root before its script has loaded",
    "x-plain": "a defined custom element that is not form-associated",
    "x-face": "a defined, form-associated custom element"
  },
  "states": [
    {
      "id": "hover",
      "group": "interaction",
      "holdsWhen": "The pointer is over the element, and the element is neither disabled nor holding a state: checked, indeterminate, pressed, selected, current, expanded or open.",
      "condition": ":is(:hover, [data-hover]):where(:not(:is(:disabled, [disabled], [aria-disabled=\"true\"]), :is(:checked, [aria-checked=\"true\"], [checked]:not(input, option)), :is(input[type=\"checkbox\"]:indeterminate, [aria-checked=\"mixed\"], [indeterminate]), :is([aria-pressed=\"true\"], [pressed]), :is([aria-selected=\"true\"], [selected]:not(option)), :is([aria-current]:not([aria-current=\"false\"], [aria-current=\"\"]), [current]), :is([aria-expanded=\"true\"], [expanded]), :is([open], :popover-open)))",
      "base": ":is(:hover, [data-hover])",
      "excludes": [
        "disabled",
        "checked",
        "indeterminate",
        "pressed",
        "selected",
        "current",
        "expanded",
        "open"
      ],
      "author": null,
      "componentWrites": null,
      "native": ":hover",
      "forced": "data-hover",
      "panda": "hover",
      "pandaBase": "&:is(:hover, [data-hover])",
      "pandaSame": false,
      "materials": "hover",
      "usedBy": [
        "every interactive component"
      ],
      "basis": "A disabled form-associated root still matches :hover, and a hover paint over a held state hides that state (ui-interaction-dev, hover.face-only). So the condition carries both guards (D34, D63).",
      "fixtures": {
        "match": [
          "<x-plain data-hover></x-plain>",
          "<button data-hover></button>",
          "<x-plain data-hover aria-checked=\"false\"></x-plain>",
          "<x-plain data-hover aria-pressed=\"false\"></x-plain>",
          "<x-plain data-hover aria-expanded=\"false\"></x-plain>"
        ],
        "noMatch": [
          "<x-plain></x-plain>",
          "<x-plain data-hover aria-disabled=\"true\"></x-plain>",
          "<x-undefined data-hover disabled></x-undefined>",
          "<button data-hover disabled></button>",
          "<x-undefined data-hover checked></x-undefined>",
          "<x-plain data-hover aria-checked=\"true\"></x-plain>",
          "<x-plain data-hover aria-checked=\"mixed\"></x-plain>",
          "<x-plain data-hover aria-pressed=\"true\"></x-plain>",
          "<x-plain data-hover aria-selected=\"true\"></x-plain>",
          "<x-plain data-hover aria-current=\"page\"></x-plain>",
          "<x-plain data-hover aria-expanded=\"true\"></x-plain>",
          "<x-undefined data-hover open></x-undefined>"
        ]
      },
      "interactive": "hover"
    },
