{
  "densityOrder": [
    "compact",
    "default",
    "loose"
  ],
  "families": {
    "control": {
      "slotUnits": 6,
      "insetUnits": [
        0.5,
        1,
        2
      ],
      "gapUnits": [
        0,
        1,
        2
      ],
      "height": "slot + 2*inset",
      "radiusUnits": [
        0,
        1,
        2,
        3,
        "height/2"
      ]
    },
    "chip": {
      "slotUnits": 4,
      "inset": "control inset",
      "gap": "control gap",
      "height": "4u + 2*inset",
      "labelEdge": "control labelEdge / 2",
      "radius": "control requested curvature capped to chip height/2"
    },
    "badge": {
      "heightUnits": 4,
      "minWidthUnits": 4,
      "inlineInsetUnits": 0.5,
      "width": "max(height, contentWidth + 2*inlineInset)",
