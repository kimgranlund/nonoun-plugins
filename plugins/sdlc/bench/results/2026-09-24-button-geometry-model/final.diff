--- /dev/null
+++ b/packages/gen-ui/src/components/geometry-scope/geometry-scope.tsx
@@ -0,0 +1,29 @@
+import type { ComponentPropsWithoutRef } from "react";
+import type { RadiusStyle, Scale, Size, Tier } from "../../geometry/geometry.generated.js";
+
+export interface GeometryScopeProps extends ComponentPropsWithoutRef<"div"> {
+  tier: Tier;
+  scale: Scale;
+  size?: Size;
+  radius?: RadiusStyle;
+}
+
+// `size` renders on an inner div, not the outer one: the generated
+// [data-tier][data-scale] block (specificity 0,2,0) sets
+// --g-height: var(--g-md-height) and would beat a [data-size] alias
+// (0,1,0) on the same element, so the alias must sit one level down
+// where it inherits the --g-lg-* vars instead.
+export function GeometryScope({
+  tier,
+  scale,
+  size,
+  radius,
+  children,
+  ...props
+}: GeometryScopeProps) {
+  return (
+    <div data-tier={tier} data-scale={scale} data-radius={radius} {...props}>
+      {size === undefined ? children : <div data-size={size}>{children}</div>}
+    </div>
+  );
+}
