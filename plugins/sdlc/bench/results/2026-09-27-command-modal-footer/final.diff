+// ── the always-visible keyboard-hint footer ─────────────────────────────────────────────────────────────
+
+describe('ui-command-modal — footer part (keyboard hints)', () => {
+  it('creates exactly ONE <footer data-part="footer"> after the list, inside the same ui-modal dialog', () => {
+    const { el, list, modal, dialog } = makePalette([option('a', 'Alpha')])
+    const footers = el.querySelectorAll('[data-part="footer"]')
+    expect(footers).toHaveLength(1)
+    const footer = footers[0] as HTMLElement
+    expect(footer.tagName).toBe('FOOTER')
+    expect(footer.closest('[data-part="dialog"]')).toBe(dialog)
+    expect(footer.closest('ui-modal')).toBe(modal)
+    expect(list.closest('[data-part="dialog"]')).toBe(dialog)
+    let sib = footer.previousElementSibling
+    let foundList = false
+    while (sib) { if (sib === list) { foundList = true; break } sib = sib.previousElementSibling }
+    expect(foundList).toBe(true)
+    el.remove()
+  })
+
+  it('holds exactly 3 hints, each with at least one <kbd>, labelled Navigate / Select / Close', () => {
+    const { el } = makePalette([option('a', 'Alpha')])
+    const footer = el.querySelector<HTMLElement>('[data-part="footer"]')!
+    const hints = footer.querySelectorAll<HTMLElement>('[data-hint]')
+    expect(hints).toHaveLength(3)
+    for (const h of hints) expect(h.querySelectorAll('kbd').length).toBeGreaterThan(0)
+    const texts = [...hints].map((h) => h.textContent ?? '')
+    expect(texts.some((t) => t.includes('Navigate'))).toBe(true)
+    expect(texts.some((t) => t.includes('Select'))).toBe(true)
+    expect(texts.some((t) => t.includes('Close'))).toBe(true)
+    el.remove()
+  })
+
+  it('the footer and its <kbd>s carry no tabindex and no role', () => {
+    const { el } = makePalette([option('a', 'Alpha')])
+    const footer = el.querySelector<HTMLElement>('[data-part="footer"]')!
+    for (const node of [footer, ...footer.querySelectorAll('kbd')]) {
+      expect(node.hasAttribute('tabindex')).toBe(false)
+      expect(node.hasAttribute('role')).toBe(false)
+    }
+    el.remove()
+  })
+
+  it('stays visible and attached when the query matches nothing', () => {
+    const { el, search } = makePalette([option('a', 'Alpha')])
+    const footer = el.querySelector<HTMLElement>('[data-part="footer"]')!
+    search.textContent = 'zzzz-no-match'
+    search.dispatchEvent(new Event('input', { bubbles: true }))
+    expect(el.querySelector('[role=option]:not([hidden])')).toBeNull()
+    expect(footer.hidden).toBe(false)
+    expect(footer.isConnected).toBe(true)
+    expect(el.contains(footer)).toBe(true)
+    el.remove()
+  })
+
+  it('disconnect + reconnect keeps exactly one footer, the same node', () => {
+    const { el } = makePalette([option('a', 'Alpha')])
+    const before = el.querySelector('[data-part="footer"]')
+    el.remove()
+    document.body.append(el)
+    expect(el.querySelectorAll('[data-part="footer"]')).toHaveLength(1)
+    expect(el.querySelector('[data-part="footer"]')).toBe(before)
+    el.remove()
+  })
+})
