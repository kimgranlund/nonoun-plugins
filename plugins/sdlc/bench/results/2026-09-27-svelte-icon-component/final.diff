+import { page } from 'vitest/browser';
+import { afterEach, describe, expect, it } from 'vitest';
+import { render } from 'vitest-browser-svelte';
+import '../../app.css';
+import Icon from './Icon.svelte';
+import { geometryRows } from '../preset/geometry/geometry.generated.js';
+
+const CDN_BASE = 'https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/';
+
+function classList(el: Element): string[] {
+	return [...el.classList].sort();
+}
+
+function phosphorLinks(weight: string): HTMLLinkElement[] {
+	return [
+		...document.head.querySelectorAll<HTMLLinkElement>(`link[data-phosphor-weight="${weight}"]`)
+	];
+}
+
+describe('Icon.svelte', () => {
+	afterEach(() => {
+		document.body.querySelectorAll('[data-testid]').forEach((el) => el.remove());
+	});
+
+	it('renders `icon ph ph-<name>` for the regular weight', async () => {
+		await render(Icon, { name: 'house', 'data-testid': 'regular' });
+
+		const el = page.getByTestId('regular').element();
+		expect(el.tagName).toBe('I');
+		expect(classList(el)).toEqual(['icon', 'ph', 'ph-house']);
+	});
+
+	it('renders `icon ph-bold ph-<name>` for the bold weight, with no bare `ph`', async () => {
+		await render(Icon, { name: 'house', weight: 'bold', 'data-testid': 'bold' });
+
+		const el = page.getByTestId('bold').element();
+		expect(classList(el)).toEqual(['icon', 'ph-bold', 'ph-house']);
+		expect(el.classList.contains('ph')).toBe(false);
+	});
+
+	it('appends a caller class after the recipe and Phosphor classes', async () => {
+		await render(Icon, { name: 'gear', class: 'extra', 'data-testid': 'extra' });
+
+		expect(classList(page.getByTestId('extra').element())).toEqual([
+			'extra',
+			'icon',
+			'ph',
+			'ph-gear'
+		]);
+	});
+
+	it('is aria-hidden with no role when no label is given', async () => {
+		await render(Icon, { name: 'house', 'data-testid': 'decorative' });
+
+		const el = page.getByTestId('decorative').element();
+		expect(el.getAttribute('aria-hidden')).toBe('true');
+		expect(el.hasAttribute('role')).toBe(false);
+		expect(el.hasAttribute('aria-label')).toBe(false);
+	});
+
+	it('is role="img" named by the label when a label is given', async () => {
+		await render(Icon, { name: 'house', label: 'Home' });
+
+		const img = page.getByRole('img', { name: 'Home' });
+		await expect.element(img).toBeInTheDocument();
+		expect(img.element().hasAttribute('aria-hidden')).toBe(false);
+	});
+
+	it('does not let pass-through attributes override the a11y contract', async () => {
+		await render(Icon, {
+			name: 'house',
+			role: 'button',
+			'aria-hidden': 'false',
+			'data-testid': 'override'
+		});
+
+		const el = page.getByTestId('override').element();
+		expect(el.getAttribute('aria-hidden')).toBe('true');
+		expect(el.hasAttribute('role')).toBe(false);
+	});
+
+	it('passes data-size through to the element', async () => {
+		await render(Icon, { name: 'house', 'data-size': 'lg', 'data-testid': 'sized' });
+
+		expect(page.getByTestId('sized').element().getAttribute('data-size')).toBe('lg');
+	});
+
+	it('injects exactly one stylesheet link per weight, with the jsdelivr href, SRI and crossorigin', async () => {
+		await render(Icon, { name: 'house' });
+		await render(Icon, { name: 'gear' });
+		await render(Icon, { name: 'house', weight: 'bold' });
+
+		for (const weight of ['regular', 'bold']) {
+			const links = phosphorLinks(weight);
+			expect(links, `${weight} link count`).toHaveLength(1);
+			const [link] = links;
+			expect(link.getAttribute('rel')).toBe('stylesheet');
+			expect(link.getAttribute('href')).toBe(`${CDN_BASE}${weight}/style.css`);
+			expect(link.getAttribute('integrity')).toMatch(/^sha384-[A-Za-z0-9+/]+={0,2}$/);
+			expect(link.getAttribute('crossorigin')).toBe('anonymous');
+		}
+	});
+});
+
+describe('Icon resolved-CSS cells', () => {
+	it('resolves font-size, width and height to the geometry icon value for every geometryRows cell (27 cases)', async () => {
+		let casesRun = 0;
+
+		for (const row of geometryRows) {
+			const wrapper = document.createElement('div');
+			wrapper.setAttribute('data-tier', row.tier);
+			wrapper.setAttribute('data-scale', row.scale);
+			document.body.appendChild(wrapper);
+
+			const screen = await render(
+				Icon,
+				{ target: wrapper, props: { name: 'house', 'data-size': row.size } },
+				{}
+			);
+			const el = wrapper.querySelector('i');
+			if (!el) throw new Error('Icon did not render an <i> element');
+
+			const computed = getComputedStyle(el);
+			const label = `${row.tier}/${row.scale}/${row.size}`;
+			expect(computed.fontSize, label).toBe(`${row.icon}px`);
+			expect(computed.width, label).toBe(`${row.icon}px`);
+			expect(computed.height, label).toBe(`${row.icon}px`);
+
+			await screen.unmount();
+			wrapper.remove();
+			casesRun++;
+		}
+
+		expect(casesRun).toBe(27);
+	});
+});
