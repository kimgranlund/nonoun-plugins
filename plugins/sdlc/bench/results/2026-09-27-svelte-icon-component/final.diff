+<script module lang="ts">
+	import type { HTMLAttributes } from 'svelte/elements';
+
+	export type IconWeight = 'regular' | 'thin' | 'light' | 'bold' | 'fill' | 'duotone';
+
+	// No `size` prop: size is context (data-tier / data-scale / data-size on an
+	// ancestor or on this element via ...rest), never a recipe variant.
+	export type IconProps = Omit<HTMLAttributes<HTMLElement>, 'children'> & {
+		name: string;
+		weight?: IconWeight;
+		label?: string;
+	};
+
+	const PHOSPHOR_BASE = 'https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.2/src/';
+
+	// SRI hashes for @phosphor-icons/web@2.1.2 src/<weight>/style.css (researcher-L1.md).
+	const PHOSPHOR_SRI: Record<IconWeight, string> = {
+		regular: 'sha384-6p9AefaqUhEVheRlj1mpAkbngHXy9mbYMrIdcIt4Jlc9lOLIablJq3bBsLOjGwZ7',
+		bold: 'sha384-nblAP2mo2pVPyMQZDw9Xy9Cwgs9lowushAYep4w5+Q9kF4Ibf3n0B/gCMVdR+Vqy',
+		fill: 'sha384-pPVoXE8ft+zxKtxIDDI7SfTK6y95NHm4qa+hKEg/hs8VkjW5IP+9/dGOPCbDpUPl',
+		light: 'sha384-GzhNOdwUkh38xzoNEY1vRdLr+w8q+bXEJsd/km6Ef61w1Kfk+lself6cn14ilrpO',
+		thin: 'sha384-ZrguSahlNzFt9jT0cuIhTCpssPYg2cCEoWz7Bpd96tKHthb+kBAIugSMdw0DUcEy',
+		duotone: 'sha384-UVFvhZP7fWAENUPOoq61rJg5ef6QZW0k5vpAn71041/QS4STvUcJQCGNhStZLGx9'
+	};
+
+	/**
+	 * Appends the weight's Phosphor stylesheet to document.head once, shared by every
+	 * Icon instance. Client-only: call it from $effect, never during SSR.
+	 */
+	function ensurePhosphorStylesheet(weight: IconWeight) {
+		if (document.head.querySelector(`link[data-phosphor-weight="${weight}"]`)) return;
+
+		const link = document.createElement('link');
+		link.rel = 'stylesheet';
+		link.href = `${PHOSPHOR_BASE}${weight}/style.css`;
+		link.integrity = PHOSPHOR_SRI[weight];
+		link.crossOrigin = 'anonymous';
+		link.setAttribute('data-phosphor-weight', weight);
+		document.head.appendChild(link);
+	}
+</script>
+
+<script lang="ts">
+	import { icon } from 'styled-system/recipes/index.mjs';
+
+	let { name, weight = 'regular', label, class: className, ...rest }: IconProps = $props();
+
+	// $effect never runs during SSR, so document is only touched on the client;
+	// it re-runs when `weight` changes after mount.
+	$effect(() => {
+		ensurePhosphorStylesheet(weight);
+	});
+
+	// Regular weight uses the bare `ph` class; other weights use `ph-<weight>` only.
+	// Svelte 5 clsx-style array: falsy entries drop, className may be any ClassValue.
+	const classes = $derived([
+		icon(),
+		weight === 'regular' ? 'ph' : `ph-${weight}`,
+		`ph-${name}`,
+		className
+	]);
+</script>
+
+<!-- rest first, so pass-through attributes (data-size, ...) land but cannot override the a11y contract -->
+<i
+	class={classes}
+	{...rest}
+	role={label ? 'img' : undefined}
+	aria-label={label || undefined}
+	aria-hidden={label ? undefined : 'true'}
+></i>
