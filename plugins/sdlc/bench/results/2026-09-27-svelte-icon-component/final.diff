+import { defineRecipe } from '@pandacss/dev';
+
+// Icon recipe, doc 13-panda-implementation.md Layer 3.
+// Size comes only from var(--g-icon) (Layer 1, context-resolved from the CSV via
+// the generator): font-size, width and height all track the icon geometry.
+// `size` is not a variant here: it is the `data-size` context attribute (AGENTS.md
+// rule 2). Phosphor classes (ph, ph-<weight>, ph-<name>) are added by the component.
+export const icon = defineRecipe({
+	className: 'icon',
+	staticCss: ['*'],
+	base: {
+		display: 'inline-flex',
+		alignItems: 'center',
+		justifyContent: 'center',
+		lineHeight: '1',
+		flexShrink: '0',
+		fontSize: 'var(--g-icon)',
+		width: 'var(--g-icon)',
+		height: 'var(--g-icon)'
+	}
+});
