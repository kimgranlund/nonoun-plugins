+import { describe, expect, it } from 'vitest';
+import { render } from 'svelte/server';
+import Icon from './Icon.svelte';
+
+// Server (node) project: there is no `document` here, so a successful render proves
+// the component only touches the DOM from $effect, which never runs during SSR.
+describe('Icon.svelte SSR', () => {
+	it('renders an <i> with the Phosphor classes without touching document', () => {
+		expect(typeof (globalThis as { document?: unknown }).document).toBe('undefined');
+
+		let body = '';
+		expect(() => {
+			body = render(Icon, { props: { name: 'house' } }).body;
+		}).not.toThrow();
+
+		expect(body).toContain('<i');
+		expect(body).toContain('ph-house');
+		expect(body).toContain('aria-hidden="true"');
+	});
+
+	it('renders a labelled bold icon as role="img" on the server', () => {
+		const { body } = render(Icon, { props: { name: 'house', weight: 'bold', label: 'Home' } });
+
+		expect(body).toContain('ph-bold');
+		expect(body).toContain('role="img"');
+		expect(body).toContain('aria-label="Home"');
+	});
+});
