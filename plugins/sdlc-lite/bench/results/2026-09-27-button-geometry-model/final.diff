+// @vitest-environment jsdom
+import { render, screen } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+import { GeometryScope } from "./geometry-scope";
+
+describe("GeometryScope", () => {
+  it("GeometryScope sets tier and scale together", () => {
+    render(
+      <GeometryScope tier="content" scale="lg" data-testid="scope">
+        x
+      </GeometryScope>,
+    );
+    const el = screen.getByTestId("scope");
+    expect(el.getAttribute("data-tier")).toBe("content");
+    expect(el.getAttribute("data-scale")).toBe("lg");
+    expect(el.hasAttribute("data-size")).toBe(false);
+    expect(el.hasAttribute("data-radius")).toBe(false);
+  });
+
+  it("GeometryScope puts size on an inner element, never on the tier and scale element", () => {
+    render(
+      <GeometryScope tier="product" scale="md" size="sm" radius="pill" data-testid="scope2">
+        <span data-testid="child">x</span>
+      </GeometryScope>,
+    );
+    const outer = screen.getByTestId("scope2");
+    expect(outer.getAttribute("data-tier")).toBe("product");
+    expect(outer.getAttribute("data-scale")).toBe("md");
+    expect(outer.getAttribute("data-radius")).toBe("pill");
+    expect(outer.hasAttribute("data-size")).toBe(false);
+    const inner = screen.getByTestId("child").parentElement!;
+    expect(inner).not.toBe(outer);
+    expect(inner.parentElement).toBe(outer);
+    expect(inner.getAttribute("data-size")).toBe("sm");
+    expect(inner.hasAttribute("data-tier")).toBe(false);
+  });
+});
