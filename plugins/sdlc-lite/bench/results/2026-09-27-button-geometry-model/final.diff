@@ -0,0 +1,28 @@
+import type { ComponentPropsWithoutRef } from "react";
+import type { RadiusStyle, Scale, Size, Tier } from "../../geometry/geometry.generated.js";
+
+export interface GeometryScopeProps extends ComponentPropsWithoutRef<"div"> {
+  tier: Tier;
+  scale: Scale;
+  size?: Size;
+  radius?: RadiusStyle;
+}
+
+// Sets the geometry context (--g-* / --r-* vars) for everything inside it.
+// data-size never lands on the scope element: the [data-tier][data-scale]
+// rule would outrank the [data-size] alias there, so a given size goes on
+// an inner wrapper instead.
+export function GeometryScope({
+  tier,
+  scale,
+  size,
+  radius,
+  children,
+  ...props
+}: GeometryScopeProps) {
+  return (
+    <div data-tier={tier} data-scale={scale} data-radius={radius} {...props}>
+      {size === undefined ? children : <div data-size={size}>{children}</div>}
+    </div>
+  );
+}
