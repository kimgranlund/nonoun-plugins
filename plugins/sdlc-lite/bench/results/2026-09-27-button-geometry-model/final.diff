+import { readdirSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { describe, expect, it } from "vitest";
+import { semanticTokens } from "../panda/tokens";
+
+// Recipe guard (REQ-PND-01, Q5). Size, tier, scale and radius style are
+// context attributes resolved into --g-* and --r-* vars, and colors are the
+// semantic tokens in src/panda/tokens.ts, so every recipe is walked and:
+// - no variant dimension may be named size, tier, scale or radius;
+// - a geometry property (GEOMETRY_KEY, including every condition or
+//   responsive value nested under one) must be var(--g-*) or var(--r-*), a
+//   calc() over them with unitless numbers only, or 0; margins and offsets
+//   may also be auto;
+// - a color property (COLOR_KEY, same nesting rule) must name a semantic
+//   token or be transparent, currentColor or inherit;
+// - every {colors.*} reference inside any value must name a semantic token;
+// - no value may carry a hex color;
+// - any other length literal must be in LENGTH_ALLOWLIST.
+// A bare CSS color keyword inside a composite value such as boxShadow is
+// not detected; composite values reach colors through {colors.*}.
+// LENGTH_ALLOWLIST is the recorded REQ-PND-01 exception: 1px and 1.5px are
+// stroke widths (borders, inset box-shadow rings), 2px is the focus ring's
+// width and offset, -2px is an inset focus ring's offset.
+const LENGTH_ALLOWLIST = new Set(["1px", "1.5px", "2px", "-2px"]);
+
+const CONTEXT_DIMENSIONS = new Set(["size", "tier", "scale", "radius"]);
+
+// Longhand and Panda shorthand names for properties that set size, padding,
+// margin, offset, type size or radius.
+const GEOMETRY_KEY =
+  /^(h|w|minH|minW|maxH|maxW|boxSize|height|width|minHeight|minWidth|maxHeight|maxWidth|inlineSize|blockSize|p|px|py|pt|pb|pl|pr|ps|pe|padding.*|m|mx|my|mt|mb|ml|mr|ms|me|margin.*|inset.*|top|right|bottom|left|gap|columnGap|rowGap|fontSize|lineHeight|textStyle|rounded.*|border.*Radius)$/;
+const AUTO_OK_KEY = /^(m|mx|my|mt|mb|ml|mr|ms|me|margin.*|inset.*|top|right|bottom|left)$/;
+
+// Longhand and Panda shorthand names for properties whose whole value is one
+// color.
+const COLOR_KEY =
+  /^(color|bg|background|backgroundColor|borderColor|border(Top|Right|Bottom|Left|Inline|Block)Color|outlineColor|fill|stroke|caretColor|accentColor|colorPalette)$/;
+const COLOR_KEYWORDS = new Set(["transparent", "currentColor", "inherit"]);
+
+function tokenPaths(node: object, prefix = ""): string[] {
+  return Object.entries(node).flatMap(([key, value]) => {
+    const path = prefix ? `${prefix}.${key}` : key;
+    if (value && typeof value === "object" && "value" in value) return [path];
+    return value && typeof value === "object" ? tokenPaths(value, path) : [];
+  });
+}
+const SEMANTIC_COLORS = new Set(tokenPaths(semanticTokens.colors ?? {}));
+
+const CONTEXT_VAR = /var\(--[gr]-[a-z0-9-]+\)/g;
+const COLOR_REF = /\{colors\.([^}]+)\}/g;
+const LENGTH = /-?\d*\.?\d+(px|rem|em|vh|vw|pt|%)(?![a-zA-Z])/g;
+const HEX = /#[0-9a-fA-F]{3,8}\b/;
+
+function geometryValueOk(key: string, value: unknown): boolean {
+  if (value === 0 || value === "0") return true;
+  if (typeof value !== "string") return false;
+  if (value === "auto" && AUTO_OK_KEY.test(key)) return true;
+  if (!value.includes("var(--")) return false;
+  const rest = value.replace(CONTEXT_VAR, "V").trim();
+  return rest === "V" || /^calc\([V\s\d.+\-*/()]*\)$/.test(rest);
+}
+
+function colorValueOk(value: unknown): boolean {
+  return typeof value === "string" && (COLOR_KEYWORDS.has(value) || SEMANTIC_COLORS.has(value));
+}
+
+function violations(recipe: unknown): string[] {
+  const out: string[] = [];
+  if (recipe === null || typeof recipe !== "object") return out;
+  const variants = (recipe as { variants?: unknown }).variants;
+  if (variants && typeof variants === "object") {
+    for (const dimension of Object.keys(variants)) {
+      if (CONTEXT_DIMENSIONS.has(dimension)) out.push(`variants.${dimension}: context dimension`);
+    }
+  }
+  return out.concat(walk(recipe, ""));
+}
+
+// `owner` is the nearest geometry or color property above this object, so a
+// condition or responsive value (minHeight: { base: ..., _hover: ... }) is
+// checked against the property it sets, not against its own key.
+function walk(node: object, path: string, owner?: string): string[] {
+  const out: string[] = [];
+  for (const [key, value] of Object.entries(node)) {
+    const at = path ? `${path}.${key}` : key;
+    const prop = GEOMETRY_KEY.test(key) || COLOR_KEY.test(key) ? key : owner;
+    if (value !== null && typeof value === "object") {
+      out.push(...walk(value, at, prop));
+      continue;
+    }
+    if (prop && GEOMETRY_KEY.test(prop)) {
+      if (!geometryValueOk(prop, value)) out.push(`${at}: geometry ${JSON.stringify(value)}`);
+      continue;
+    }
+    if (prop && COLOR_KEY.test(prop)) {
+      if (!colorValueOk(value)) out.push(`${at}: color ${JSON.stringify(value)}`);
+      continue;
+    }
+    if (typeof value !== "string") continue;
+    if (HEX.test(value)) out.push(`${at}: hex ${value}`);
+    for (const [, ref] of value.matchAll(COLOR_REF)) {
+      if (!SEMANTIC_COLORS.has(ref!)) out.push(`${at}: color ref ${ref}`);
+    }
+    for (const length of value.match(LENGTH) ?? []) {
+      if (!LENGTH_ALLOWLIST.has(length)) out.push(`${at}: length ${length}`);
+    }
+  }
+  return out;
+}
+
+const here = dirname(fileURLToPath(import.meta.url));
+
+async function loadRecipes(): Promise<Record<string, unknown>> {
+  const found: Record<string, unknown> = {};
+  for (const file of readdirSync(here).filter((f) => f.endsWith(".recipe.ts"))) {
+    const mod = (await import(pathToFileURL(join(here, file)).href)) as Record<string, unknown>;
+    for (const [name, value] of Object.entries(mod)) {
+      if (value && typeof value === "object" && "className" in value) found[name] = value;
+    }
+  }
+  return found;
+}
+
+describe("recipe guard", () => {
+  it("recipes stay on geometry vars and semantic tokens", async () => {
+    const recipes = await loadRecipes();
+    expect(Object.keys(recipes).sort()).toEqual(["buttonRecipe", "iconRecipe"]);
+    for (const [name, recipe] of Object.entries(recipes)) {
+      expect(violations(recipe), name).toEqual([]);
+    }
+  });
+
+  it("the guard refuses context variants, off-model geometry, non-semantic colors and hex", () => {
+    expect(SEMANTIC_COLORS.has("control.surface")).toBe(true);
+    expect(violations({ variants: { size: { sm: {} } } })).toHaveLength(1);
+    expect(violations({ variants: { tier: {}, scale: {}, radius: {} } })).toHaveLength(3);
+    expect(violations({ base: { height: "32px" } })).toHaveLength(1);
+    expect(violations({ base: { h: "10" } })).toHaveLength(1);
+    expect(violations({ base: { minW: 40 } })).toHaveLength(1);
+    expect(violations({ base: { marginInline: "4" } })).toHaveLength(1);
+    expect(violations({ base: { top: "3px" } })).toHaveLength(1);
+    expect(violations({ base: { gap: "calc(var(--g-inset) - 2px)" } })).toHaveLength(1);
+    expect(violations({ base: { _hover: { borderRadius: "md" } } })).toHaveLength(1);
+    expect(
+      violations({ base: { minHeight: { base: "2px", _hover: "var(--g-height)" } } }),
+    ).toHaveLength(1);
+    expect(violations({ base: { boxShadow: "0 0 0 3px {colors.focusRing}" } })).toHaveLength(1);
+    expect(violations({ base: { color: "#fff" } })).toHaveLength(1);
+    expect(violations({ base: { color: "red" } })).toHaveLength(1);
+    expect(violations({ base: { _hover: { bg: "gray.500" } } })).toHaveLength(1);
+    expect(violations({ base: { bg: { base: "blue.500" } } })).toHaveLength(1);
+    expect(violations({ base: { outline: "2px solid {colors.gray.500}" } })).toHaveLength(1);
+    expect(
+      violations({
+        variants: { variant: { primary: { bg: "control.surface" } } },
+        base: {
+          height: "var(--g-height)",
+          gap: "calc(var(--g-inset) / 2)",
+          paddingInline: "0",
+          marginInline: "auto",
+          bg: { base: "transparent", _hover: "surface.hover" },
+          outline: "2px solid {colors.focusRing}",
+          boxShadow: "inset 0 0 0 1px {colors.surface.selected}",
+        },
+      }),
+    ).toEqual([]);
+  });
+});
