+// Icon box on the geometry model: width, height and font size all read
+// --g-icon from the surrounding GeometryScope, so the icon scales with
+// the same context as the control it sits in.
+import { defineRecipe } from "@pandacss/dev";
+
+export const iconRecipe = defineRecipe({
+  className: "icon",
+  base: {
+    display: "inline-flex",
+    alignItems: "center",
+    justifyContent: "center",
+    flexShrink: "0",
+    width: "var(--g-icon)",
+    height: "var(--g-icon)",
+    fontSize: "var(--g-icon)",
+  },
+});
