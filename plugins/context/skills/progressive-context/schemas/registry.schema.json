{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "registry.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "entry",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "entry": {
      "type": "string",
      "minLength": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "descriptor.schema.json"
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "intent",
          "target"
        ],
        "properties": {
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
