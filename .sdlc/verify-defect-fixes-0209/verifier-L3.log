e integration branch',\n                sh(tr, 'cat-file', '-e', 'fanout/tr:.sdlc/x').returncode != 0)\n+        # T-0258: numbered folders under `ticket_root: tickets` with .sdlc/config untracked (gitignored): the\n+        # integration worktree has no config, so the close must still resolve the ticket through ticket_root.\n+        nt, ntl = tmp / 'ntroot', tmp / 'ntlanes'\n+        (nt / '.sdlc' / 'tickets' / '0001-x').mkdir(parents=True)\n+        (nt / '.sdlc' / 'config').write_text('ticket_folders: numbered\\nticket_root: tickets\\n', encoding='utf-8')\n+        (nt / '.gitignore').write_text('.sdlc/config\\n.worktrees/\\n', encoding='utf-8')\n+        (nt / '.sdlc' / 'tickets' / '0001-x' / 'handoff.md').write_text(\n+            '---\\nid: T-0001\\ntitle: \"Ticket x\"\\ntype: chore\\nstatus: ready\\nsize: S\\npriority: P2\\n'\n+            'depends: []\\ncreated: 2026-01-01\\n---\\n\\n## Goal\\nx\\n', encoding='utf-8')\n+        for args in (('init', '-q', '-b', 'main'), ('config', 'user.name', 'fanout selftest'),\n+                     ('config', 'user.email', 'selftest@example.invalid'), ('config', 'commit.gpgsign', 'false'),\n+                     ('add', '-A'), ('commit', '-q', '-m', 'fixture')):\n+            p = sh(nt, *args)\n+            expect(f'untracked config lane: fixture git {args} exited 0, got {p.returncode} stderr={p.stderr!r}',\n+                   p.returncode == 0)\n+        proc = fanout(nt, '--integration', 'fanout/nt', '--lanes-dir', str(ntl), '--driver', tdrv, 'a=T-0001')\n+        got = report_rows(ntl)\n+        expect(f'untracked config lane: run exits 0 merged and closed, got {proc.returncode} {got} '\n+               f'stderr={proc.stderr!r}', proc.returncode == 0 and got.get('T-0001') == 'merged')\n+        expect('untracked config lane: the ticket folder is archived under .sdlc/tickets on the branch',\n+               sh(nt, 'cat-file', '-e', 'fanout/nt:.sdlc/tickets/.0001-x/handoff.md').returncode == 0)\n+        expect('untracked config lane: no .sdlc/0001-x folder on the branch',\n+               sh(nt, 'cat-file', '-e', 'fanout/nt:.sdlc/0001-x').returncode != 0)\n         # 13. Overlap: alpha and beta both edit shared.txt (line 1 and the last line). Beta reaches its merge\n         # while alpha's driver still runs, waits for alpha (the earlier lane), and merges after it; without\n         # the wait, alpha's driver times out. Negative control: disjoint lanes report none and never wait.\n=================== T-0261\ncommit c23fb948a85bcc1ac84a041bf09a58ea96d93838\nAuthor: Kim Granlund <kim.granlund@gmail.com>\nDate:   Mon Oct 5 15:29:24 2026 -0700\n\n    T-0261: steps.py precheck and run.sh refuse a task handoff with no ## Goal before a planner or reviewer starts\n    \n    Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>\n\ndiff --git a/plugins/sdlc-lite/scripts/run-selftest.sh b/plugins/sdlc-lite/scripts/run-selftest.sh\nindex a64a170..2086a4b 100755\n--- a/plugins/sdlc-lite/scripts/run-selftest.sh\n+++ b/plugins/sdlc-lite/scripts/run-selftest.sh\n@@ -828,6 +828,30 @@ res $'## Goal\\nx'\n   \"$here/run.sh\" planner L1 .sdlc/t/handoff.md >/dev/null 2>&1) || fail \"spec gate: planner run with SDLC_SPECGATE=off failed\"\n ! tail -n 1 \"$sgd/runs.jsonl\" | jq -e 'has(\"specgate\")' >/dev/null 2>&1 \\\n   || fail \"spec gate: a planner run line carries a specgate key: $(tail -n 1 \"$sgd/runs.jsonl\")\"\n+# Goal precheck (T-0261): a planner or plan-reviewer on a task handoff with no \"## Goal\" section exits 2\n+# before any attempt record, naming steps.py and the heading; with \"## Goal\" the same run exits 0.\n+gpd=\"$sgrepo/.sdlc/gp\"\n+mkdir -p \"$gpd\"\n+printf '%s\\n' '## Task goal' x >\"$gpd/handoff.md\"\n+gprun() { # gprun <role> <out file>: prints the exit code\n+  local rc=0\n+  (cd \"$sgrepo\" && env -u SDLC_SPECGATE -u SDLC_DRY_RUN STUB_RESULT=\"$tmp/res.json\" PATH=\"$tmp/bin:$PATH\" \\\n+    \"$here/run.sh\" \"$1\" L1 .sdlc/gp/handoff.md >\"$2\" 2>&1) || rc=$?\n+  echo \"$rc\"\n+}\n+rm -f \"$tmp/count\"\n+for grole in planner plan-reviewer; do\n+  rc=$(gprun \"$grole\" \"$tmp/gp1\")\n+  [[ \"$rc\" == 2 ]] || fail \"goal precheck: $grole on a handoff with no ## Goal exited $rc, want 2: $(cat \"$tmp/gp1\")\"\n+  grep -qF \"## Goal\" \"$tmp/gp1\" || fail \"goal precheck: $grole refusal does not name ## Goal: $(cat \"$tmp/gp1\")\"\n+  [[ ! -e \"$tmp/count\" ]] || fail \"goal precheck: $grole on a handoff with no ## Goal called the stub claude\"\n+  [[ -z \"$(find \"$gpd\" -name '*.attempt.json' -o -name 'runs.jsonl')\" ]] \\\n+    || fail \"goal precheck: $grole on a handoff with no ## Goal left a run record\"\n+done\n+printf '%s\\n' '## Goal' x >\"$gpd/handoff.md\"\n+res $'## Goal\\nx'\n+rc=$(gprun planner \"$tmp/gp2\")\n+[[ \"$rc\" == 0 ]] || fail \"goal precheck: planner on a handoff with ## Goal exited $rc, want 0: $(cat \"$tmp/gp2\")\"\n # Stale input: lifecycle records the launch hash; run.sh flags a handoff that changed during the run.\n srepo=\"$tmp/srepo\"\n mkdir -p \"$srepo/.sdlc/s\" \"$tmp/sbin\"\ndiff --git a/plugins/sdlc-lite/scripts/run.sh b/plugins/sdlc-lite/scripts/run.sh\nindex c5f86da..6a214f4 100755\n--- a/plugins/sdlc-lite/scripts/run.sh\n+++ b/plugins/sdlc-lite/scripts/run.sh\n@@ -60,6 +60,8 @@\n # Exit codes: 0 ok, 1 run failed or returned no result (run_lifecycle.py also turns an exit 0 with no\n # saved result into 1), 2 usage or preflight, or a spec gate refusal, 3 result fails the result check,\n # 4 ticket budget at 80 percent or more with no ack.\n+# Goal precheck: before a planner or plan-reviewer run on a task handoff (not a step dir), run.sh runs\n+# steps.py precheck on the handoff dir; no ## Goal section prints the reason and exits 2 before any attempt record.\n # Spec gate: before a plan-reviewer run (dry runs too, never in the run_lifecycle.py child, either\n # backend), run.sh runs scripts/specgate.py check on the handoff dir. A refusal prints specgate's\n # lines and \"run.sh: specgate.py check refused the plan in <dir>; replan, or set SDLC_SPECGATE=off\"\n@@ -263,6 +265,17 @@ if [[ \"${SDLC_LIFECYCLE_CHILD:-}\" != 1 ]]; then\n   fi\n fi\n \n+# Goal precheck (T-0261): a planner or plan-reviewer on a task handoff (<task dir>/handoff.md, not a step\n+# dir) needs the ## Goal section steps.py split reads; refuse before any attempt record, dry runs too.\n+if [[ \"${SDLC_LIFECYCLE_CHILD:-}\" != 1 && ( \"$role\" == planner || \"$role\" == plan-reviewer ) \\\n+      && \"$(basename \"$handoff\")\" == handoff.md && \"$(basename \"$dir\")\" != step-* ]]; then\n+  if ! goal_out=$(python3 \"$plugin_root/scripts/steps.py\" precheck \"$dir\" 2>&1); then\n+    printf '%s\\n' \"$goal_out\" >&2\n+    echo \"run.sh: steps.py precheck refused the task handoff in $dir; add a ## Goal section\" >&2\n+    exit 2\n+  fi\n+fi\n+\n # Spec gate (see the header): plan-reviewer only, parent process only, dry runs too.\n if [[ \"${SDLC_LIFECYCLE_CHILD:-}\" != 1 && \"$role\" == plan-reviewer ]]; then\n   if [[ \"${SDLC_SPECGATE:-}\" == off ]]; then\ndiff --git a/plugins/sdlc-lite/scripts/steps.py b/plugins/sdlc-lite/scripts/steps.py\nindex 59481bf..ed1d65a 100755\n--- a/plugins/sdlc-lite/scripts/steps.py\n+++ b/plugins/sdlc-lite/scripts/steps.py\n@@ -2,7 +2,7 @@\n \"\"\"Split a planner result into one step handoff per step, so /chain never parses a plan by hand.\n \n Usage: steps.py {split <planner.md | task dir> [--only N ...] [--guard-timeout SECONDS] |\n-                 lint <planner.md | task dir> | review <task dir> | lane <task dir> | next <step dir> |\n+                 lint <planner.md | task dir> | precheck <task dir> | review <task dir> | lane <task dir> | next <step dir> |\n                  resume <task dir> |\n                  swap <step dir> [--timeout SECONDS] |\n                  widen <step dir> <path> [<path> ...] [--timeout SECONDS] | selftest}\n@@ -51,6 +51,8 @@ Usage: steps.py {split <planner.md | task dir> [--only N ...] [--guard-timeout S\n             that counts after it, fails results.structure_error (role planner, plan-reviewer), it\n             prints \"invalid result: <path>: <reason>\" before the review check and the goal read.\n             Every check runs before any write: a failure prints on stderr, exits 1, writes nothing.\n+  precheck  fail fast (exit 1, naming ## Goal) when <task dir>/handoff.md has no ## Goal section, as split\n+            would; run.sh calls it before a planner or plan-reviewer on a task handoff. Writes nothing.\n   lint      pick the plan the same way split does, then check that every command-like code span\n             under a step's ### Acceptance criteria (outside ``` fences) parses under bash -n, with\n             each <placeholder> replaced first, and that none holds an unquoted || operator (a\n@@ -341,7 +343,7 @@ def find_plan(target):\n     raise Fail(f'steps: no such file or directory: {target}')\n \n \n-def read_goal(task_dir):\n+def read_goal(task_dir, allow_empty=False):\n     handoff = task_dir / 'handoff.md'\n     if not handoff.is_file():\n         raise Fail(f'steps: no task handoff at {handoff}; the goal comes from its ## Goal section')\n@@ -364,7 +366,7 @@ def read_goal(task_dir):\n         body.pop(0)\n     while body and not body[-1].strip():\n         body.pop()\n-    if not body:\n+    if not body and not allow_empty:\n         raise Fail(f'steps: the ## Goal section of {handoff} is empty')\n     return '\\n'.join(body)\n \n@@ -1038,6 +1040,17 @@ def split(target, only=None, guard_timeout=None):\n     return written\n \n \n+def cmd_precheck(task_dir):\n+    \"\"\"Fail fast, before any planner or plan-reviewer runs, when split could not read the task goal.\"\"\"\n+    try:\n+        read_goal(pathlib.Path(task_dir), allow_empty=True)\n+    except Fail as e:\n+        print(f'{e}; steps.py split reads the goal from the ## Goal section of the task handoff '\n+              f'(a \"## Task goal\" heading belongs to step handoffs only)', file=sys.stderr)\n+        return 1\n+    return 0\n+\n+\n def cmd_split(target, only, guard_timeout=None):\n     try:\n         written = split(target, only, guard_timeout)\n@@ -2223,6 +2236,14 @@ def selftest():\n         want1 = f'## Task goal\\n{GOAL}\\n\\n{STEP1}\\n'\n         want2 = f'## Task goal\\n{GOAL}\\n\\n{STEP2}\\n'\n \n+        # (precheck) T-0261: a task handoff with no ## Goal (a ## Task goal heading) is refused before any\n+        # planner runs; one with ## Goal passes\n+        d = task(plan=None, handoff='## Task goal\\nx\\n')\n+        refused('(precheck) a handoff with only ## Task goal is refused naming ## Goal', ['precheck', str(d)], d,\n+                '## Goal')\n+        d = task(plan=None, handoff=HANDOFF)\n+        rc, out, err = run_main(['precheck', str(d)])\n+        check('(precheck) a handoff with ## Goal passes silently', rc == 0 and out == '' and err == '')\n         # (a) normal plan followed by ## Risks\n         d = task()\n         rc, out, _ = run_main(['split', str(d / 'planner-L2.md')])\n@@ -3655,6 +3676,8 @@ def main(argv):\n                         'a timeout is a red guard')\n     p = sub.add_parser('lint', help='check that criterion commands parse under bash -n; writes nothing')\n     p.add_argument('target', help='a planner-*.md file, or a task dir (its newest planner-*.md by recorded run order)')\n+    p = sub.add_parser('precheck', help='fail fast when a task dir handoff has no ## Goal section; writes nothing')\n+    p.add_argument('task', help='a task dir holding handoff.md')\n     p = sub.add_parser('next', help='print the next escalation action for a step dir; writes nothing')\n     p.add_argument('step_dir', help='a step dir (step-<n>/) holding handoff.md and builder/verifier results')\n     p = sub.add_parser('resume', help='print the step dir a resumed /chain continues from, and its next action')\n@@ -3686,6 +3709,8 @@ def main(argv):\n         return cmd_widen(a.step_dir, a.paths + extra, a.timeout)\n     if a.cmd == 'selftest':\n       