diff --git a/strkit/words.py b/strkit/words.py
index 9060c97..7687296 100644
--- a/strkit/words.py
+++ b/strkit/words.py
@@ -7,3 +7,33 @@ _WORD = re.compile(r'[A-Za-z0-9]+')
 def split_words(text):
     """Return the alphanumeric words of text, in order."""
     return _WORD.findall(text or '')
+
+
+def truncate_at_boundary(slug, max_length, sep):
+    """Cut slug to at most max_length characters, at a word boundary.
+
+    A slug no longer than max_length is returned unchanged. Otherwise the
+    longest prefix of whole sep-separated words that fits is returned, with
+    no trailing sep. If even the first word is too long, the first
+    max_length characters of slug are returned. max_length below 1 raises
+    ValueError.
+
+    >>> truncate_at_boundary('hello-world-again', 12, '-')
+    'hello-world'
+    >>> truncate_at_boundary('supercalifragilistic-word', 5, '-')
+    'super'
+    """
+    if max_length < 1:
+        raise ValueError('max_length must be at least 1, got %r' % (max_length,))
+    if len(slug) <= max_length:
+        return slug
+    words = slug.split(sep) if sep else [slug]
+    kept = words[0]
+    if len(kept) > max_length:
+        return slug[:max_length]
+    for word in words[1:]:
+        candidate = kept + sep + word
+        if len(candidate) > max_length:
+            break
+        kept = candidate
+    return kept
