+    def test_example_first_word_too_long(self):
+        self.assertEqual(slugify('Supercalifragilistic word', max_length=5), 'super')
+
+    def test_none_unchanged(self):
+        text = 'Hello World Again'
+        self.assertEqual(slugify(text, max_length=None), slugify(text))
+        self.assertEqual(slugify(text, max_length=None), 'hello-world-again')
+
+    def test_shorter_than_max_unchanged(self):
+        self.assertEqual(slugify('Hello World', max_length=50), 'hello-world')
+
+    def test_equal_to_max_unchanged(self):
+        self.assertEqual(slugify('Hello World', max_length=11), 'hello-world')
+
+    def test_prefix_exactly_max_length_is_kept(self):
+        self.assertEqual(slugify('Hello World Again', max_length=11), 'hello-world')
+
+    def test_one_over_boundary_drops_last_word(self):
+        self.assertEqual(slugify('Hello World', max_length=10), 'hello')
+
+    def test_cut_lands_on_separator_has_no_trailing_sep(self):
+        # 'hello-' fits in 6 characters, but the result must not end in sep.
+        self.assertEqual(slugify('Hello World', max_length=6), 'hello')
+
+    def test_cut_lands_right_after_word(self):
+        self.assertEqual(slugify('Hello World', max_length=5), 'hello')
+
+    def test_result_never_longer_than_max(self):
+        text = 'The quick brown fox jumps over the lazy dog'
+        for n in range(1, len(slugify(text)) + 3):
