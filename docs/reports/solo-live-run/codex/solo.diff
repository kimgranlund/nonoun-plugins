diff --git a/strkit/words.py b/strkit/words.py
index 9060c97..8f060c8 100644
--- a/strkit/words.py
+++ b/strkit/words.py
@@ -7,3 +7,27 @@ _WORD = re.compile(r'[A-Za-z0-9]+')
 def split_words(text):
     """Return the alphanumeric words of text, in order."""
     return _WORD.findall(text or '')
+
+
+def truncate_at_boundary(slug, max_length, sep):
+    """Limit a slug to whole words, slicing only if its first word is too long."""
+    if max_length < 1:
+        raise ValueError('max_length must be at least 1')
+    if len(slug) <= max_length:
+        return slug
+    if not sep:
+        return slug[:max_length]
+
+    words = slug.split(sep)
+    if len(words[0]) > max_length:
+        return slug[:max_length]
+
+    prefix = words[0]
+    for word in words[1:]:
+        candidate = prefix + sep + word
+        if len(candidate) > max_length:
+            break
+        prefix = candidate
+    while prefix.endswith(sep):
+        prefix = prefix[:-len(sep)]
+    return prefix
