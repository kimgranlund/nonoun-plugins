+
+    def test_max_length_prefix_fits_exactly(self):
+        # 'hello-world' is exactly 11 characters and the slug is longer.
+        self.assertEqual(
+            slugify('Hello World Again', max_length=11), 'hello-world')
+
+    def test_max_length_one_short_drops_last_word(self):
+        self.assertEqual(slugify('Hello World', max_length=10), 'hello')
+
+    def test_max_length_uses_sep(self):
+        self.assertEqual(
+            slugify('Hello World Again', sep='_', max_length=12),
