diff --git a/strkit/words.py b/strkit/words.py
index 9060c97..d16a06f 100644
--- a/strkit/words.py
+++ b/strkit/words.py
@@ -7,3 +7,28 @@ _WORD = re.compile(r'[A-Za-z0-9]+')
 def split_words(text):
     """Return the alphanumeric words of text, in order."""
     return _WORD.findall(text or '')
+
+
+def truncate_at_boundary(slug, max_length, sep):
+    """Cut slug to at most max_length characters, at a word boundary.
+
+    Words are the sep-separated parts of slug. Return the longest prefix of
+    whole words that fits, with no trailing sep. If the first word alone is
+    too long, return the first max_length characters of slug.
+
+    >>> truncate_at_boundary('hello-world-again', 12, '-')
+    'hello-world'
+    """
+    if max_length < 1:
+        raise ValueError('max_length must be at least 1')
+    if len(slug) <= max_length:
+        return slug
+    kept = []
+    if sep:
+        for word in slug.split(sep):
+            if len(sep.join(kept + [word])) > max_length:
+                break
+            kept.append(word)
+    if not kept:
+        return slug[:max_length]
+    return sep.join(kept)
