--- a/mathkit/stats.py
+++ b/mathkit/stats.py
@@ -7,3 +7,16 @@ def mean(values):
     if not values:
         raise ValueError("mean of empty sequence")
     return sum(values) / len(values)
+
+
+def median(values):
+    """Median. Odd count: the middle value; even count: the float mean of the
+    two middle values. Raises ValueError for an empty sequence. Does no
+    mutate its input and accepts any iterable."""
+    ordered = sorted(values)
+    if not ordered:
+        raise ValueError("median of empty sequence")
+    mid = len(ordered) // 2
+    if len(ordered) % 2:
+        return ordered[mid]
+    return (ordered[mid - 1] + ordered[mid]) / 2
