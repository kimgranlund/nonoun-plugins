+class MedianTests(unittest.TestCase):
+    def test_odd_returns_middle_after_sorting(self):
+        self.assertEqual(median([5, 1, 3]), 3)
+
+    def test_single_value(self):
+        self.assertEqual(median([7]), 7)
+
+    def test_even_returns_float_mean_of_middle_two(self):
+        result = median([4, 1, 3, 2])
+        self.assertEqual(result, 2.5)
+        self.assertIsInstance(result, float)
+
+    def test_even_with_equal_middles_is_float(self):
+        result = median([2, 2])
+        self.assertEqual(result, 2.0)
+        self.assertIsInstance(result, float)
+
+    def test_empty_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            median([])
+
+    def test_empty_iterator_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            median(iter([]))
+
+    def test_does_not_mutate_input(self):
+        values = [3, 1, 2]
+        median(values)
+        self.assertEqual(values, [3, 1, 2])
+
+    def test_accepts_generator(self):
+        self.assertEqual(median(x for x in (9, 1, 5)), 5)
+
+    def test_accepts_tuple_and_set(self):
+        self.assertEqual(median((3, 1, 2)), 2)
+        self.assertEqual(median({1, 2, 3, 4}), 2.5)
+
+
