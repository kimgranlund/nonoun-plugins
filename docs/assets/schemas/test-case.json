{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test-case.json",
  "title": "Test case",
  "description": "One typed test case: precondition, one action, expected result, and the requirement IDs it traces to.",
  "type": "object",
  "required": [
    "id",
    "precondition",
    "action",
    "expected",
    "traces"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TC-[0-9]+$"
    },
    "title": {
      "type": "string"
    },
    "precondition": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "expected": {
      "type": "string"
    },
    "traces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "description": "A requirement ID such as REQ-001."
      }
    },
    "command": {
      "type": "string",
      "description": "The command that runs the case, when it is automated."
    }
  }
}
